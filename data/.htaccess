# Bloqueia QUALQUER acesso direto por navegador a esta pasta.
# Aqui fica o banco (gateway.sqlite) com a chave da API e a senha do
# admin — nunca pode ser baixável pela web. Não apague este arquivo.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
